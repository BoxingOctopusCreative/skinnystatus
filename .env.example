# SkinnyStatus: host env supplies Infisical credentials (or app secrets for local/dev).
# Copy to .env for local development.
#
# When INFISICAL_CLIENT_ID, INFISICAL_CLIENT_SECRET, and INFISICAL_PROJECT_ID are set,
# app secrets are loaded from that Infisical project (and overwrite matching .env keys).
# Postgres URL is loaded from Infisical path /db/url (not DATABASE_URL in Infisical root).
# Auth secret is loaded from Infisical path /app/auth_secret.
# Mailgun is loaded from Infisical path /mailgun (api_key, domain, from, region).
# GitHub OAuth is loaded from Infisical path /oauth/github (client_id, client_secret).
# Google OAuth is loaded from Infisical path /oauth/google (client_id, client_secret).
# Cloudflare R2 (private avatars) is loaded from Infisical path /r2.
# Cloudflare Turnstile (email auth) is loaded from Infisical path /turnstile.
# Stripe billing is loaded from Infisical path /stripe.
# Sentry is loaded from Infisical path /sentry (dsn, optional environment, release, org, project, auth_token).
# Otherwise, set app secrets below directly.

# Infisical (optional for local; required in environments that use Infisical)
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=dev
# INFISICAL_SITE_URL=https://app.infisical.com

# Site
SITE_DESCRIPTION=Service status
ORIGIN=http://localhost:5173

# Publishing
# Path pages: {ORIGIN}/{PUBLISHING_PATH_PREFIX}/{slug} (admin preview)
# Static deploys use the same path_prefix on the host, or subdomain mode
PUBLISHING_BASE_DOMAIN=localhost
# PUBLISHING_APEX_DOMAIN=status.example.com
PUBLISHING_PATH_PREFIX=s

# Deploy host tokens are per-user (Dashboard → Settings), not env vars.

# Mailgun (status page email subscriptions; platform-level).
# With Infisical, set /mailgun/api_key, /mailgun/domain, /mailgun/from, optional /mailgun/region.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=SkinnyStatus <status@mg.example.com>
# MAILGUN_REGION=us

# Database (Postgres required). Used when Infisical is unset.
# With Infisical, set secret /db/url instead; it overwrites this.
DATABASE_URL=postgresql://skinnystatus:skinnystatus@localhost:5432/skinnystatus

# Auth (required in production; use a long random secret).
# With Infisical, set /app/auth_secret instead; it overwrites this.
AUTH_SECRET=change-me-in-production-use-a-long-random-string
# BETTER_AUTH_SECRET is also accepted

# Encrypts per-user host credentials (32-byte hex or base64). Optional; defaults to HKDF(AUTH_SECRET).
# CREDENTIALS_ENCRYPTION_KEY=

# GitHub OAuth for user sign-up / sign-in (optional; omit to disable).
# With Infisical, set /oauth/github/client_id and /oauth/github/client_secret instead.
# Callback URL in the GitHub OAuth App: {ORIGIN}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth for user sign-up / sign-in (optional; omit to disable).
# With Infisical, set /oauth/google/client_id and /oauth/google/client_secret instead.
# Authorized redirect URI in Google Cloud Console: {ORIGIN}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare R2 for private profile pictures (optional; omit to disable avatar uploads).
# With Infisical, set under /r2: account_id, access_key_id, secret_access_key, bucket,
# optional endpoint, region (default auto).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_REGION=auto

# Cloudflare Turnstile for email sign-up / sign-in (optional; omit to disable).
# With Infisical, set under /turnstile: site_key, secret.
# Widget domains should include localhost, 127.0.0.1, and skinnystatus.app.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Stripe billing (CAD monthly subscriptions + Managed Payments). Prefer Infisical path /stripe:
#   secret_key, webhook_secret, price_bronze, price_silver, price_gold, price_platinum
# Get STRIPE_SECRET_KEY (prefer restricted rk_) and STRIPE_PUBLISHABLE_KEY from
# https://dashboard.stripe.com/apikeys (publishable key is optional; Checkout is server-redirected).
# Create Products with tax code txcd_10103100 (Managed Payments eligible) and CAD monthly Prices,
# accept Managed Payments Terms of Service in the Dashboard, then paste price IDs below.
# Webhook endpoint: {ORIGIN}/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created|updated|deleted
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BRONZE=
# STRIPE_PRICE_SILVER=
# STRIPE_PRICE_GOLD=
# STRIPE_PRICE_PLATINUM=

# In development, demo@example.com / demo-password is seeded automatically.
# Force that seed in other environments with:
# SEED_EXAMPLE_USER=1

# Health checks
# CHECKS_INTERVAL_SECONDS=60
# CHECKS_TIMEOUT_MS=5000
# CHECKS_DEGRADED_LATENCY_MS=2000

# Sentry (errors, tracing, session replay). Prefer Infisical path /sentry:
#   dsn (required), environment, release, org, project, auth_token
# Infisical mirrors dsn/environment/release to PUBLIC_* for the browser SDK.
# When Infisical is unset, set these directly (DSN is public; safe in client bundles):
# PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# PUBLIC_SENTRY_RELEASE=
# Source map upload during `npm run build` (CI/build-time; auth_token is not needed at runtime):
# SENTRY_ORG=boxingoctopuscreative
# SENTRY_PROJECT=skinnystatus
# SENTRY_AUTH_TOKEN=
