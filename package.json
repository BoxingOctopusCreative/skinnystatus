{
	"name": "skinnystatus",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"build:status-template": "npm run build --prefix packages/status-page-template",
		"db:push": "node --import tsx scripts/db-push.ts",
		"db:generate": "node --import tsx scripts/db-generate.ts",
		"db:migrate": "node --import tsx scripts/db-migrate.ts",
		"db:studio": "drizzle-kit studio --config drizzle.config.ts"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/js": "^10.0.1",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"better-auth": "~1.6.22",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@better-auth/passkey": "~1.4.21",
		"@fontsource/cascadia-mono": "^5.3.0",
		"@fontsource/jost": "^5.3.0",
		"@infisical/sdk": "^5.0.2",
		"@sentry/sveltekit": "^10.67.0",
		"aws4fetch": "^1.0.20",
		"fflate": "^0.8.3",
		"ioredis": "^5.11.1",
		"lucide-svelte": "^1.0.1",
		"mysql2": "^3.23.1",
		"postgres": "^3.4.9",
		"stripe": "^22.3.2"
	}
}
